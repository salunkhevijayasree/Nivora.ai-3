# =======================================
# NIVORA AI - SERVER ENV EXAMPLE
# Copy this file to .env and fill in your values
# =======================================

PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Database Direct (Optional)
DATABASE_URL=

# Twilio SMS (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Hospital Config
HOSPITAL_NAME=Nivora General Hospital
HOSPITAL_PHONE=
HOSPITAL_EMERGENCY_LINE=
